@{
    ViewData["Title"] = "Home Page";
}
@model IEnumerable<_16july.Models.Student>

<div class="text-center">
    <h1 class="display-4">Welcome to Students Portal</h1>
</div>

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <table border="1" cellpadding="10">
        <tr>
            <th>ID</th>
            <th>NAME</th>
            <th>AGE</th>
            <th>COURSE</th>
            <th>GENDER</th>
            <th>FEES</th>
            <th>QUALIFICATION</th>

        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.id</td>
                <td>@item.name</td>
                <td>@item.age</td>
                <td>@item.course</td>
                <td>@item.gender</td>
                <td>@item.fees</td>
                <td>@item.quali</td>
            </tr>
        }
    </table>
</div>
