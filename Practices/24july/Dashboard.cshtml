@model _24_July.Models.Register
<h3> Dashboard </h3>

<h2>Welcome @ViewBag.User</h2>

<p> Example of ASP.Net Session with MVC, tag helpher, model binding </p>

<br />



<div class="text-center">
    <h3 class="display-4">Student Admission Form</h3>
</div>

@using (Html.BeginForm())
{
    @Html.ValidationSummary(true)

    <table>

        <tr>
            <td>Name :</td>
            <td>
                @Html.TextBoxFor(m => m.name)
                @Html.ValidationMessageFor(m => m.name)
            </td>
        </tr>

        <tr>
            <td>Age :</td>
            <td>
                @Html.TextBoxFor(m => m.age)
                @Html.ValidationMessageFor(m => m.age)
            </td>
        </tr>

        <tr>
            <td>Email ID :</td>
            <td>
                @Html.TextBoxFor(m => m.email)
                @Html.ValidationMessageFor(m => m.email)
            </td>
        </tr>

        <tr>
            <td>Course :</td>
            <td>
                @Html.TextBoxFor(m => m.course)
                @Html.ValidationMessageFor(m => m.course)
            </td>
        </tr>

        <tr>
            <td></td>
            <td>
                <input type="submit" value="Register" class="btn btn-primary" />
            </td>
        </tr>

    </table>
}

@if (ViewBag.Message != null)
{
    <h3 style="color:green">@ViewBag.Message</h3>
}



<a asp-action="Logout" class="btn btn-danger">LOGOUT</a>