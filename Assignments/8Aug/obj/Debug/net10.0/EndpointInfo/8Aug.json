          "courseId": {
            "type": "integer",
            "format": "int32"
          },
          "courseName": {
            "minLength": 1,
            "type": "string"
          },
          "duration": {
            "maximum": 24,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
