  "components": {
    "schemas": {
      "Batch": {
        "required": [
          "batchName",
          "startDate"
        ],
        "type": "object",
        "properties": {
          "batchId": {
            "type": "integer",
            "format": "int32"
          },
          "batchName": {
            "minLength": 1,
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "students": {
            "type": "array",
