@model EmployeeManagementMVC.Models.Employee

@{
    ViewData["Title"] = "Delete Employee Confirmation";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="mb-0 fw-bold">⚠️ Delete Employee Confirmation</h4>
            </div>
            <div class="card-body p-4">
                <p class="lead text-danger fw-semibold">
                    Are you sure you want to delete this employee? This action cannot be undone.
                </p>

                <div class="card bg-light p-3 mb-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Employee ID:</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Id</dd>

                        <dt class="col-sm-4 text-muted">Full Name:</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.Name</dd>

                        <dt class="col-sm-4 text-muted">Email:</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4 text-muted">Phone:</dt>
                        <dd class="col-sm-8">@Model.Phone</dd>

                        <dt class="col-sm-4 text-muted">Salary:</dt>
                        <dd class="col-sm-8 text-success fw-bold">$@Model.Salary.ToString("N2")</dd>

                        <dt class="col-sm-4 text-muted">Status:</dt>
                        <dd class="col-sm-8">
                            @if (Model.Status == "Active")
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">Department:</dt>
                        <dd class="col-sm-8">@Model.DepartmentName</dd>

                        <dt class="col-sm-4 text-muted">Designation:</dt>
                        <dd class="col-sm-8">@Model.DesignationName</dd>
                    </dl>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">← Cancel and Return</a>
                        <button type="submit" class="btn btn-danger px-4">Confirm Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>