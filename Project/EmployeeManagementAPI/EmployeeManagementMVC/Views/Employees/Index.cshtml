@model EmployeeManagementMVC.Models.EmployeeFilterViewModel

@{
    ViewData["Title"] = "Employee Directory";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold text-primary mb-0">👥 Employees</h2>
        <p class="text-muted mb-0">Search, filter, and manage staff members</p>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            ➕ Add New Employee
        </a>
    }
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger shadow-sm" role="alert">
        @ViewBag.ErrorMessage
    </div>
}

<!-- Search and Filter Form Card -->
<div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <!-- Keyword Search -->
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Search (Name / Email / Phone)</label>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="Type keyword..." />
            </div>

            <!-- Department Dropdown -->
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Department</label>
                <select name="departmentId" asp-items="ViewBag.DepartmentList" class="form-select form-select-sm">
                    <option value="">-- All Departments --</option>
                </select>
            </div>

            <!-- Designation Dropdown -->
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Designation</label>
                <select name="designationId" asp-items="ViewBag.DesignationList" class="form-select form-select-sm">
                    <option value="">-- All Designations --</option>
                </select>
            </div>

            <!-- Status Dropdown -->
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="All" selected="@(Model.Status == "All")">All Statuses</option>
                    <option value="Active" selected="@(Model.Status == "Active")">Active</option>
                    <option value="Inactive" selected="@(Model.Status == "Inactive")">Inactive</option>
                </select>
            </div>

            <!-- Filter Actions -->
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold" title="Apply Filter">
                    🔍 Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Clear Filters">
                    ↺
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Results Header -->
<div class="d-flex justify-content-between align-items-center mb-2 px-1">
    <span class="text-muted small">
        Showing <strong>@(Model.Employees?.Count() ?? 0)</strong> employee(s)
    </span>
</div>

<!-- Employees Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th scope="col" style="width: 5%;">ID</th>
                        <th scope="col" style="width: 20%;">Name</th>
                        <th scope="col" style="width: 22%;">Contact</th>
                        <th scope="col" style="width: 15%;">Department</th>
                        <th scope="col" style="width: 15%;">Designation</th>
                        <th scope="col" style="width: 10%;">Salary</th>
                        <th scope="col" style="width: 8%;">Status</th>
                        <th scope="col" style="width: 10%;">Joined</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th scope="col" style="width: 10%; text-align: center;">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Employees != null && Model.Employees.Any())
                    {
                        @foreach (var item in Model.Employees)
                        {
                            <tr>
                                <td class="fw-bold">@item.Id</td>
                                <td class="fw-semibold">@item.Name</td>
                                <td>
                                    <div><small class="text-muted">📧 @item.Email</small></div>
                                    <div><small class="text-muted">📞 @item.Phone</small></div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.DepartmentName) && item.DepartmentName != "Unassigned")
                                    {
                                        <span class="badge bg-info text-dark">@item.DepartmentName</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Unassigned</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.DesignationName) && item.DesignationName != "Unassigned")
                                    {
                                        <span class="badge bg-success">@item.DesignationName</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Unassigned</span>
                                    }
                                </td>
                                <td class="fw-semibold text-success">
                                    $@item.Salary.ToString("N2")
                                </td>
                                <td>
                                    @if (item.Status == "Active")
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                                <td>
                                    @item.JoiningDate.ToString("yyyy-MM-dd")
                                </td>

                                @if (User.IsInRole("Admin"))
                                {
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">
                                                Edit
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger ms-1">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <em>No employees found matching your search criteria.</em>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>